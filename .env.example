# ==============================================================================
# Google Service Account Credentials (Choose ONE method for Render)
# ==============================================================================
# Method 1 (Recommended on Render): Paste the full JSON key content directly
# GOOGLE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Method 2: Base64-encoded string of your service account credentials.json
# GOOGLE_CREDENTIALS_BASE64=...

# Method 3: File path (e.g. Render Secret File at /etc/secrets/credentials.json or local)
# GOOGLE_CREDENTIALS_FILE=credentials.json
